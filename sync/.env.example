HAUNT_SYNC_HOST=sync.your-domain.example
HAUNT_SYNC_PORTAL_ORIGIN=https://signin.your-client-publisher.example
HAUNT_SYNC_DB_PASSWORD=replace-with-a-random-private-database-password
HAUNT_SYNC_IMAGE=ghcr.io/example-git/haunt:sync-latest
# Optional existing TLS SMTP provider. Email sign-in/recovery are unavailable until configured.
HAUNT_SYNC_SMTP_HOST=
HAUNT_SYNC_SMTP_PORT=587
HAUNT_SYNC_SMTP_USERNAME=
HAUNT_SYNC_SMTP_PASSWORD=
HAUNT_SYNC_MAIL_FROM=
