# Copy this file to .env, configure your hostname/IP, then docker compose up -d.
# No source checkout or local build is needed for the published image.
# Client/setup traffic uses bundled Nginx on container TCP 80/443, mapped to host
# TCP 80/443 by default. HAUNT_HTTP_PORT/HAUNT_HTTPS_PORT override the host ports.
# The internal 127.0.0.1:8080 backend is not published by the supplied Compose file.
HAUNT_IMAGE=ghcr.io/example-git/haunt:latest
# Optional override; otherwise choose the name in the setup wizard:
# HAUNT_NAME=Haunt
HAUNT_PUBLIC_URL=https://haunt.example.com
# Public IP mapped to this host. Forward the SAME UDP ports through every NAT.
HAUNT_MEDIA_PUBLIC_IP=198.51.100.10
HAUNT_MEDIA_PORT_MIN=50000
HAUNT_MEDIA_PORT_MAX=50100

# Automatic Let's Encrypt HTTPS; public DNS and forwarded TCP 80/443 required.
# Optional contact email for the ACME account:
# HAUNT_ACME_EMAIL=admin@example.com

# Open the private first-time setup link printed in the service startup log.
# Choose the owner username and password in the wizard on the main web port.
# Optional unattended installation (never resets an existing owner):
# HAUNT_BOOTSTRAP_USERNAME=owner
# HAUNT_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password

# Existing HTTPS reverse proxy: target the mapped host HTTP port (80 by default)
# and trust ONLY the proxy's CIDRs.
# HAUNT_TLS_MODE=proxy
# HAUNT_PROXY_CIDRS=172.30.0.2/32
# Supplied certificates instead: HAUNT_TLS_MODE=provided, mounted read-only at
# /data/tls/fullchain.pem and /data/tls/privkey.pem. Restart after renewal.

# LAN text testing: HAUNT_PUBLIC_URL=http://192.168.1.10 with its actual LAN IP.
# Browser microphone/camera capture still requires HTTPS outside localhost.

# All normal server policy/media/storage variables remain available. Do not copy
# HAUNT_DATABASE_URL, HAUNT_DATA_DIR or HAUNT_INSTANCE_ID from another install.
# PostgreSQL and the installation ID are provisioned privately in the /data volume.

# Optional application updates; runtime dependencies still use image upgrades.
# HAUNT_APP_UPDATE_REPOSITORY=example-git/haunt
# Or HAUNT_APP_UPDATE_MANIFEST_URL=https://updates.example.com/haunt-app.json
# HAUNT_APP_UPDATE_AUTO=true
# HAUNT_APP_UPDATE_INTERVAL=21600
# Private release access: mount a token file read-only and set its container path.
# HAUNT_APP_UPDATE_TOKEN_FILE=/run/secrets/release-token
